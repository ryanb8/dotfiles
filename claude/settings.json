{
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.pydantic.dev)",
      "Bash(tree:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Read(./env.example)",
      "Read(./env.infra)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.aws/**)",
      "Read(./**/.ssh/**)",
      "Read(./**/credentials/**)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.modal.toml)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(modal secret:*)",
      "Bash(modal environment:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(aws:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(redis-cli:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(brew install:*)",
      "Bash(npm install -g:*)",
      "Bash(pip install:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.atuin/bin/atuin hook claude-code"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.atuin/bin/atuin hook claude-code"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.atuin/bin/atuin hook claude-code"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/hooks/guard_dangerous_commands.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "printf \"\\033[0;35m%s\\033[0;32m%s\\033[0;34m %s \\033[0m\" \"$(whoami)\" \"$(git branch --show-current 2>/dev/null | sed 's/^/ (/' | sed 's/$/)/' || echo '')\" \"$(basename \\\"$(pwd)\\\")\""
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "model": "opus",
  "idleCompaction": false
}
